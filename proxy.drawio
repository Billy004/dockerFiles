                </mxCell>
                <mxCell id="proxy_net" value="Internal Network: proxy_net (bridge)&#10;- Containers only&#10;- Not exposed externally" style="swimlane;startSize=44;rounded=1;html=1;strokeColor=#9e9e9e;fillColor=#262626;fontStyle=1;dashed=1;fontColor=#ffffff;" parent="docker_host" vertex="1">
