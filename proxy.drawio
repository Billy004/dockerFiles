                <mxCell id="title" value="Nginx Reverse Proxy with Docker (No Direct Container Exposure)" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#ffffff;" parent="1" vertex="1">
