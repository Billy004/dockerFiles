                    <mxGeometry x="100" y="320" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="lbl_flow_response" value="5) Response back to client" style="text;whiteSpace=wrap;html=1;align=left;fontColor=#ffffff;" parent="dmz_label" vertex="1">
