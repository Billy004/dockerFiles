                <mxCell id="note_isolation" value="Containers have no published ports.&#10;All access via Nginx on proxy_net." style="note;whiteSpace=wrap;html=1;strokeColor=#9e9e9e;fillColor=#333333;fontColor=#ffffff;" parent="proxy_net" vertex="1">
                    <mxGeometry x="60" y="330" width="220" height="70" as="geometry"/>
