                </mxCell>
                <mxCell id="security_note" value="External firewall/NAT: Only 80/443 to Nginx.&#10;Containers are isolated on proxy_net." style="note;whiteSpace=wrap;html=1;strokeColor=#9e9e9e;fillColor=#333333;fontColor=#ffffff;" parent="docker_host" vertex="1">
